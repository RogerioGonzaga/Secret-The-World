# Copie para .env.local e ajuste. Nunca coloque segredos reais neste arquivo.

# URL pública do site (usada em metadados, sitemap e Open Graph). Sem esta variável, o padrão é o domínio
# oficial https://partiumorar.com.br. Em desenvolvimento local use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo de dados (o nome técnico da variável foi mantido por compatibilidade).
# "demo" (padrão): exibe dados demonstrativos, sempre sinalizados.
# "production": oculta todo valor demonstrativo; cidades sem custos verificados saem do catálogo.
NEXT_PUBLIC_LIVORA_DATA_MODE=demo

# Câmbio: API Frankfurter (taxas de referência do BCE). Sem chave. Pode apontar para instância própria.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1

# Mapa (Leaflet). O servidor público do OpenStreetMap tem política de uso para baixo volume;
# em produção use um provedor de tiles com contrato e ajuste a atribuição.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">colaboradores do OpenStreetMap</a>

# Supabase (ainda não utilizado pela aplicação; necessário para contas e catálogo no banco).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # somente servidor/scripts. Nunca exponha no navegador.
